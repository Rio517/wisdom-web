---
// Home (design 002 v02 · A, "Stage"): one sentence in the middle of a faint
// path field; on click the words lift away and the paths grow out of the
// Beginning. Below: the lesson, the roadmap, and a line for grown-ups.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { LESSON_PATH, UI, href, lessonsFor } from '../../data/site.js';
import { getTranslator } from '../../i18n/index.js';
import { localeStaticPaths } from '../../i18n/config.js';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props;
const t = getTranslator(locale);
const link = path => href(locale, path);
---
<SiteLayout description={t('site.description')} current="home" locale={locale} stage clientMessages={['map.', 'lesson.ui.mapUnavailable']}>
  <section class="stage-home" aria-labelledby="hero-title">
    <figure class="stage-field" aria-label={t('home.mapLabel')}>
      <div class="map-stack" data-grow="hidden" data-state="overview">
        <img id="map-ghost" alt="" aria-hidden="true" />
        <canvas id="map-base" aria-hidden="true"></canvas>
        <canvas id="map-today" aria-hidden="true"></canvas>
        <canvas id="map-fx" aria-hidden="true"></canvas>
        <div id="map-callouts" aria-hidden="true"></div>
      </div>
    </figure>
    <div class="stage-copy">
      <p class="kicker lift">{t('home.kicker')}</p>
      <h1 id="hero-title" class="lift">{t('home.title')}</h1>
      <p class="stage-summary lift">{t('home.lede')}</p>
      <div class="stage-actions lift">
        <button class="btn btn-primary" type="button" data-grow-start>{t('home.watch')}</button>
      </div>
    </div>
    <div class="stage-after" hidden>
      <p class="stage-settled">{t('home.settled')}</p>
      <div class="stage-actions">
        <a class="btn btn-primary" href={link(LESSON_PATH)}>{t('home.startLesson')}<Fragment set:html={UI.arrow} /></a>
        <a class="btn btn-quiet" href={link('/choices/')}>{t('home.aboutLesson')}</a>
      </div>
    </div>
  </section>

  <div class="home-below">
    <section class="home-lesson" aria-labelledby="lesson-1-title">
      <p class="kicker">{t('home.lesson.kicker')}</p>
      <h2 id="lesson-1-title">{t('home.lesson.title')}</h2>
      <p class="home-lede">{t('home.lesson.lede')}</p>
      <div class="stage-actions">
        <a class="btn btn-primary" href={link(LESSON_PATH)}>{t('home.startJourney')}<Fragment set:html={UI.arrow} /></a>
        <a class="btn btn-quiet" href={link(`${LESSON_PATH}read/`)}>{t('home.readText')}</a>
      </div>
    </section>

    <section class="home-roadmap" aria-labelledby="roadmap-title">
      <h2 id="roadmap-title">{t('home.roadmap.title')}</h2>
      <ol class="roadmap">
        {lessonsFor(t).map(lesson => (
          <li data-status={lesson.status}>
            <span class="road-num" aria-hidden="true">{lesson.number}</span>
            <div>
              <h3>{lesson.href ? <a href={lesson.href}>{lesson.title}</a> : <button class="road-soon soon-trigger" type="button" aria-describedby={`road-tip-${lesson.id}`}>{lesson.title}</button>}</h3>
              {lesson.tip && <span class="soon-tip" role="tooltip" id={`road-tip-${lesson.id}`} hidden>{lesson.tip}</span>}
              <p>{lesson.summary}</p>
            </div>
            <span class="status-pill" data-status={lesson.status}>{lesson.statusLabel}</span>
          </li>
        ))}
      </ol>
    </section>

    <p class="home-grownups"><a href={link('/choices/notes/')}>{t('home.grownups')}</a></p>
  </div>

  <script>
    import { createPathsScene } from '../../lessons/choices/journey-map.js';
    import { createToken, prefersReducedMotion, wait } from '../../lessons/choices/journey-motion.js';
    import { watchField } from '../../components/stage-field.js';

    const section = document.querySelector('.stage-home');
    const figure = section?.querySelector('.stage-field');
    if (section && figure) {
      const stack = figure.querySelector('.map-stack');
      const copy = section.querySelector('.stage-copy');
      const after = section.querySelector('.stage-after');
      // A softer right-hand end than the lesson's: on a full-width stage the
      // line ends otherwise stand in a wall short of the screen edge.
      const scene = createPathsScene(figure, { labels: false, edgeFade: 0.16 });
      const field = watchField(stack, figure.querySelector('#map-base'), figure.querySelector('#map-ghost'));
      scene.show('cover', { animate: false });
      field.snapshot();
      let token = createToken();

      const settle = () => {
        after.hidden = false;
        requestAnimationFrame(() => after.classList.add('is-in'));
        after.querySelector('a')?.focus({ preventScroll: true });
      };
      section.querySelector('[data-grow-start]')?.addEventListener('click', async () => {
        token.cancel();
        const run = token = createToken();
        if (scene.failed || prefersReducedMotion()) {
          copy.hidden = true;
          scene.show('travel', { animate: false });
          stack.dataset.grow = 'shown';
          settle();
          return;
        }
        copy.classList.add('is-leaving');
        // Lines lift and fade in turn: 480 ms each, 70 ms apart (690 ms in all).
        const lines = [...copy.querySelectorAll('.lift')];
        const exits = lines.map((line, index) => line.animate(
          [{ transform: 'none', opacity: 1 }, { transform: 'translateY(-36px)', opacity: 0 }],
          { duration: 480, delay: index * 70, easing: 'cubic-bezier(.4, 0, .7, .2)', fill: 'forwards' },
        ));
        Promise.all(exits.map(exit => exit.finished)).then(() => { copy.hidden = true; });
        // The paths start before the words have quite gone.
        if (!(await wait(320, run))) return;
        await scene.show('many', { from: 'cover', animate: true, token: run });
        if (run.cancelled || !(await wait(200, run))) return;
        await scene.show('travel', { from: 'many', animate: true, token: run });
        if (!run.cancelled) settle();
      });
    }
  </script>
</SiteLayout>
