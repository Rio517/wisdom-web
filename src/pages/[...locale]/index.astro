---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE, LESSON_PATH, UI, href, lessonsFor, choicesChaptersFor } from '../../data/site.js';
import { getTranslator } from '../../i18n/index.js';
import { localeStaticPaths } from '../../i18n/config.js';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props;
const t = getTranslator(locale);
const link = path => href(locale, path);
const chapters = choicesChaptersFor(t);
const stops = chapters.map((chapter, index) => ({ ...chapter, x: ((index + 0.5) / chapters.length) * 1000 }));
const third = (stops[1].x - stops[0].x) / 3;
let trail = `M ${stops[0].x} 20 C ${stops[0].x + third} 4, ${stops[1].x - third} 36, ${stops[1].x} 20`;
for (let i = 2; i < stops.length; i += 1) trail += ` S ${stops[i].x - third} ${i % 2 ? 36 : 4}, ${stops[i].x} 20`;
---
<SiteLayout description={t('site.description')} current="home" locale={locale} clientMessages={['map.', 'lesson.ui.mapUnavailable']}>
  <div class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="kicker">{t('home.kicker')}</p>
        <h1 id="hero-title">{t('home.title')}</h1>
        <p class="hero-lede">{t('home.lede')}</p>
        <div class="actions">
          <a class="btn btn-primary" href={link(LESSON_PATH)}>{t('home.startLesson')}<Fragment set:html={UI.arrow} /></a>
          <a class="btn btn-quiet" href={link('/choices/')}>{t('home.aboutLesson')}</a>
        </div>
      </div>
      <figure class="hero-map" aria-label={t('home.mapLabel')}>
        <div class="map-stack" data-grow="hidden" data-state="overview">
          <canvas id="map-base" aria-hidden="true"></canvas>
          <canvas id="map-today" aria-hidden="true"></canvas>
          <canvas id="map-fx" aria-hidden="true"></canvas>
          <div id="map-callouts" aria-hidden="true"></div>
        </div>
        <figcaption class="hero-caption">{t('home.mapCaption')}</figcaption>
      </figure>
    </section>

    <section class="section" id="lesson-1" aria-labelledby="lesson-1-title">
      <div class="lesson-feature">
        <div class="lesson-feature-head">
          <div>
            <p class="kicker">{t('home.lesson.kicker')}</p>
            <h2 id="lesson-1-title">{t('home.lesson.title')}</h2>
            <p class="page-lede">{t('home.lesson.lede')}</p>
          </div>
          <span class="status-pill" data-status="available">{t('site.status.available')}</span>
        </div>
        <ul class="meta-row">
          <li><Fragment set:html={UI.clock} />{t('home.meta.time')}</li>
          <li><Fragment set:html={UI.people} />{t('home.meta.ages')}</li>
          <li><Fragment set:html={UI.device} />{t('home.meta.devices')}</li>
          <li><Fragment set:html={UI.text} />{t('home.meta.text')}</li>
        </ul>
        <div class="chapter-map">
          <svg class="chapter-line" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true"><path d={trail} /></svg>
          <ol class="chapter-stops" aria-label={t('home.chapters')}>
            {stops.map(chapter => (
              <li class="chapter-stop">
                <a href={chapter.href}>
                  <span class="stop-icon" set:html={chapter.icon} />
                  <span class="stop-num">{chapter.number}</span>
                  <strong>{chapter.title}</strong>
                  <span class="stop-text">{chapter.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={link(LESSON_PATH)}>{t('home.startJourney')}<Fragment set:html={UI.arrow} /></a>
          <a class="btn btn-quiet" href={link(`${LESSON_PATH}read/`)}>{t('home.readText')}</a>
          <a class="text-link" href={link('/choices/notes/')}>{t('home.notes')}</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="roadmap-title">
      <div class="section-head">
        <h2 id="roadmap-title">{t('home.roadmap.title')}</h2>
      </div>
      <ol class="roadmap">
        {lessonsFor(t).map(lesson => (
          <li data-status={lesson.status}>
            <span class="road-num" aria-hidden="true">{lesson.number}</span>
            <div>
              <h3>{lesson.href ? <a href={lesson.href}>{lesson.title}</a> : <button class="road-soon soon-trigger" type="button" aria-describedby={`road-tip-${lesson.id}`}>{lesson.title}</button>}</h3>
              {lesson.tip && <span class="soon-tip" role="tooltip" id={`road-tip-${lesson.id}`} hidden>{lesson.tip}</span>}
              <p>{lesson.summary}</p>
            </div>
            <span class="status-pill" data-status={lesson.status}>{lesson.statusLabel}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="grownups-title">
      <div class="band">
        <div>
          <h2 id="grownups-title">{t('home.together.title')}</h2>
          <p>{t('home.together.text')}</p>
          <ul class="promise-list">
            <li><Fragment set:html={UI.check} />{t('home.together.fictional')}</li>
            <li><Fragment set:html={UI.check} />{t('home.together.research')}</li>
            <li><Fragment set:html={UI.check} />{t('home.together.privacy')}</li>
            <li><Fragment set:html={UI.check} />{t('home.together.access')}</li>
          </ul>
        </div>
        <div class="link-cards">
          <a class="link-card" href={link('/choices/notes/')}><div><strong>{t('home.card.notes.title')}</strong><span>{t('home.card.notes.text')}</span></div><Fragment set:html={UI.arrow} /></a>
          <a class="link-card" href={link('/about/')}><div><strong>{t('home.card.about.title')}</strong><span>{t('home.card.about.text')}</span></div><Fragment set:html={UI.arrow} /></a>
          <a class="link-card" href={SITE.research}><div><strong>{t('home.card.research.title')}</strong><span>{t('home.card.research.text')}</span></div><Fragment set:html={UI.external} /></a>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { createPathsScene } from '../../lessons/choices/journey-map.js';
    import { createToken, prefersReducedMotion, wait } from '../../lessons/choices/journey-motion.js';

    const figure = document.querySelector('.hero-map');
    if (figure) {
      const scene = createPathsScene(figure, { labels: false });
      let token = createToken();
      const play = async () => {
        token.cancel();
        token = createToken();
        const run = token;
        if (scene.failed) return;
        if (prefersReducedMotion()) { scene.show('travel', { animate: false }); return; }
        scene.show('cover', { animate: false });
        if (!(await wait(700, run))) return;
        await scene.show('many', { from: 'cover', animate: true, token: run });
        if (run.cancelled || !(await wait(300, run))) return;
        await scene.show('travel', { from: 'many', animate: true, token: run });
      };
      play();
    }
  </script>
</SiteLayout>
