---
// Lesson 2 · Practice: the overview page, laid out like Lesson 1's (/choices/).
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { UI, href, practiceChaptersFor, practiceTakeawaysFor } from '../../../data/site.js';
import { PRACTICE_PATH, PRACTICE_READ_PATH } from '../../../lessons/practice/practice-story.js';
import { getTranslator } from '../../../i18n/index.js';
import { localeStaticPaths } from '../../../i18n/config.js';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props;
const t = getTranslator(locale);
const link = path => href(locale, path);
const title = t('practice.ui.title');
---
<SiteLayout title={title} description={t('practice.overview.description')} current="practice" locale={locale}>
  <div class="page">
    <section class="overview-hero" aria-labelledby="lesson-title">
      <div>
        <p class="kicker">{t('practice.overview.kicker', { title })}</p>
        <h1 id="lesson-title">{title}</h1>
        <p class="page-lede">{t('practice.overview.lede')}</p>
        <ul class="meta-row">
          <li><Fragment set:html={UI.clock} />{t('home.meta.time')}</li>
          <li><Fragment set:html={UI.people} />{t('overview.meta.ages')}</li>
          <li><Fragment set:html={UI.device} />{t('home.meta.devices')}</li>
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href={link(PRACTICE_PATH)}>{t('home.startJourney')}<Fragment set:html={UI.arrow} /></a>
          <a class="btn btn-quiet" href={link(PRACTICE_READ_PATH)}>{t('home.readText')}</a>
        </div>
      </div>
      <aside class="overview-card" aria-labelledby="keep-title">
        <h2 id="keep-title">{t('practice.overview.keep')}</h2>
        <ul class="takeaway-list">
          {practiceTakeawaysFor(t).map(item => (
            <li><span set:html={item.icon} /><div><strong>{item.heading}</strong><span>{item.text}</span></div></li>
          ))}
        </ul>
      </aside>
    </section>

    <section class="section" aria-labelledby="chapters-title">
      <div class="section-head">
        <h2 id="chapters-title">{t('practice.overview.stops')}</h2>
        <a class="text-link" href={link(PRACTICE_PATH)}>{t('overview.fromStart')}</a>
      </div>
      <ol class="chapter-list">
        {practiceChaptersFor(t).map(chapter => (
          <li>
            <a href={chapter.href}>
              <span class="stop-icon" set:html={chapter.icon} />
              <div><small>{chapter.number}</small><strong>{chapter.title}</strong><span>{chapter.text}</span></div>
              <span class="go" set:html={UI.arrow} />
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="together-title">
      <div class="band">
        <div>
          <h2 id="together-title">{t('overview.together.title')}</h2>
          <p>{t('overview.together.text1')}</p>
          <p>{t('overview.together.text2')}</p>
        </div>
        <div class="link-cards">
          <a class="link-card" href={link(PRACTICE_READ_PATH)}><div><strong>{t('home.readText')}</strong><span>{t('overview.card.read.text')}</span></div><Fragment set:html={UI.arrow} /></a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
