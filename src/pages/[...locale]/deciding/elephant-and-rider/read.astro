---
// Lesson 3 · The elephant and the rider as text: every step, the activity as a still, and the pictures in words.
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import LessonControls from '../../../../components/LessonControls.astro';
import { renderElephantReading, ELEPHANT_PATH, ELEPHANT_READ_PATH, ELEPHANT_TITLE } from '../../../../lessons/elephant/elephant-story.js';
import { UI, href } from '../../../../data/site.js';
import { getTranslator } from '../../../../i18n/index.js';
import { localeStaticPaths } from '../../../../i18n/config.js';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props;
const t = getTranslator(locale);
const reading = renderElephantReading({ t });
---
<SiteLayout title={t('elephant.read.title')} description={t('elephant.read.description')} current="elephant-read" locale={locale}>
  <LessonControls slot="controls" locale={locale} id="header-controls" view="text" picturesHref={href(locale, ELEPHANT_PATH)} textHref={href(locale, ELEPHANT_READ_PATH)} />
  <article class="page page-narrow">
    <header class="page-header">
      <p class="kicker">{t('elephant.read.kicker')}</p>
      <h1>{t(ELEPHANT_TITLE)}</h1>
      <p class="page-lede">{t('elephant.read.lede')}</p>
      <div class="actions">
        <a class="btn btn-primary" href={href(locale, ELEPHANT_PATH)}>{t('read.open')}<Fragment set:html={UI.arrow} /></a>
        <button class="btn btn-quiet" type="button" onclick="window.print()">{t('read.print')}</button>
      </div>
    </header>
    <div class="prose" set:html={reading} />
  </article>
</SiteLayout>
