---
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE, LESSONS, STATUS_LABEL, CHOICES_CHAPTERS, LESSON_PATH, UI, url } from '../data/site.js';

const stops = CHOICES_CHAPTERS.map((chapter, index) => ({ ...chapter, x: ((index + 0.5) / CHOICES_CHAPTERS.length) * 1000 }));
const third = (stops[1].x - stops[0].x) / 3;
let trail = `M ${stops[0].x} 20 C ${stops[0].x + third} 4, ${stops[1].x - third} 36, ${stops[1].x} 20`;
for (let i = 2; i < stops.length; i += 1) trail += ` S ${stops[i].x - third} ${i % 2 ? 36 : 4}, ${stops[i].x} 20`;
---
<SiteLayout description={SITE.description} current="home">
  <div class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="kicker">{SITE.tagline} · for readers eight and up</p>
        <h1 id="hero-title">Ideas worth <span class="keep">growing up with.</span></h1>
        <p class="hero-lede">Short, illustrated lessons about how life works: the choices we make, the things we can’t choose, and how to keep going when plans change.</p>
        <div class="actions">
          <a class="btn btn-primary" href={url(LESSON_PATH)}>Start lesson 1<Fragment set:html={UI.arrow} /></a>
          <a class="btn btn-quiet" href={url('/choices/')}>About this lesson</a>
        </div>
      </div>
      <figure class="hero-map" aria-label="A drawing of many possible life paths growing from one beginning, with one path travelled so far">
        <div class="map-stack" data-grow="hidden" data-state="overview">
          <canvas id="map-base" aria-hidden="true"></canvas>
          <canvas id="map-today" aria-hidden="true"></canvas>
          <canvas id="map-fx" aria-hidden="true"></canvas>
          <div id="map-callouts" aria-hidden="true"></div>
        </div>
        <button class="hero-replay" type="button" hidden>Play again</button>
        <figcaption class="hero-caption">Every line is a way a life could go.</figcaption>
      </figure>
    </section>

    <section class="section" id="lesson-1" aria-labelledby="lesson-1-title">
      <div class="lesson-feature">
        <div class="lesson-feature-head">
          <div>
            <p class="kicker">Lesson 1 · Choices</p>
            <h2 id="lesson-1-title">The paths we make</h2>
            <p class="page-lede">Why small choices add up, why not everything is yours to choose, and how to keep going when plans change. A guided journey with a hike, a story told two ways, a game and a life-path explorer.</p>
          </div>
          <span class="status-pill" data-status="available">{STATUS_LABEL.available}</span>
        </div>
        <ul class="meta-row">
          <li><Fragment set:html={UI.clock} />About 15 minutes</li>
          <li><Fragment set:html={UI.people} />Ages 8 and up, best read together</li>
          <li><Fragment set:html={UI.device} />Desktop and iPad</li>
          <li><Fragment set:html={UI.text} />Text version too</li>
        </ul>
        <div class="chapter-map">
          <svg class="chapter-line" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true"><path d={trail} /></svg>
          <ol class="chapter-stops" aria-label="Chapters">
            {stops.map(chapter => (
              <li class="chapter-stop">
                <a href={url(chapter.href)}>
                  <span class="stop-icon" set:html={chapter.icon} />
                  <span class="stop-num">{chapter.number}</span>
                  <strong>{chapter.title}</strong>
                  <span class="stop-text">{chapter.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={url(LESSON_PATH)}>Start the journey<Fragment set:html={UI.arrow} /></a>
          <a class="btn btn-quiet" href={url(`${LESSON_PATH}read/`)}>Read as text</a>
          <a class="text-link" href={url('/choices/notes/')}>Notes for grown-ups</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="roadmap-title">
      <div class="section-head">
        <h2 id="roadmap-title">The guide, lesson by lesson</h2>
      </div>
      <ol class="roadmap">
        {LESSONS.map(lesson => (
          <li data-status={lesson.status}>
            <span class="road-num" aria-hidden="true">{lesson.number}</span>
            <div>
              <h3>{lesson.href ? <a href={url(lesson.href)}>{lesson.title}</a> : lesson.title}</h3>
              <p>{lesson.summary}</p>
            </div>
            <span class="status-pill" data-status={lesson.status}>{STATUS_LABEL[lesson.status]}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="grownups-title">
      <div class="band">
        <div>
          <h2 id="grownups-title">Made to be read together</h2>
          <p>Each lesson explains one big idea with pictures you can touch and play with. Younger readers can explore alongside an adult; older readers will find more to think about.</p>
          <ul class="promise-list">
            <li><Fragment set:html={UI.check} />The people in the examples are made up. The ideas are real.</li>
            <li><Fragment set:html={UI.check} />Research comes first, and its sources and limits are open to read.</li>
            <li><Fragment set:html={UI.check} />No accounts, no ads and no tracking.</li>
            <li><Fragment set:html={UI.check} />Every lesson has a text version and works with a keyboard.</li>
          </ul>
        </div>
        <div class="link-cards">
          <a class="link-card" href={url('/choices/notes/')}><div><strong>Notes for grown-ups</strong><span>How to use Lesson 1, questions to ask, and the evidence behind it</span></div><Fragment set:html={UI.arrow} /></a>
          <a class="link-card" href={url('/about/')}><div><strong>About Wisdom</strong><span>What this guide is and how it’s made</span></div><Fragment set:html={UI.arrow} /></a>
          <a class="link-card" href={SITE.research}><div><strong>Research and sources</strong><span>The findings behind each lesson, on GitHub</span></div><Fragment set:html={UI.external} /></a>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { createPathsScene } from '../lessons/choices/journey-map.js';
    import { createToken, prefersReducedMotion, wait } from '../lessons/choices/journey-motion.js';

    const figure = document.querySelector('.hero-map');
    const replay = figure?.querySelector('.hero-replay');
    if (figure) {
      const scene = createPathsScene(figure, { labels: false });
      let token = createToken();
      const play = async () => {
        token.cancel();
        token = createToken();
        const run = token;
        replay.hidden = true;
        if (scene.failed) return;
        if (prefersReducedMotion()) { scene.show('travel', { animate: false }); return; }
        scene.show('cover', { animate: false });
        if (!(await wait(700, run))) return;
        await scene.show('many', { from: 'cover', animate: true, token: run });
        if (run.cancelled || !(await wait(300, run))) return;
        await scene.show('travel', { from: 'many', animate: true, token: run });
        if (!run.cancelled) replay.hidden = false;
      };
      replay.addEventListener('click', play);
      play();
    }
  </script>
</SiteLayout>
