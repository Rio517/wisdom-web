---
import '../../../lessons/choices/journey.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import { renderJourneyReading } from '../../../lessons/choices/journey-story.js';
import { DAYS, ACTIVITIES } from '../../../lessons/choices/journey-game.js';
import { SITE, UI, url } from '../../../data/site.js';

const gameDays = DAYS.map(day => ({ ...day, options: day.options.map(id => ACTIVITIES[id]) }));
const reading = renderJourneyReading({ gameDays });
---
<BaseLayout title="The paths we make" description="A guided journey about how choices add up, how learning builds on learning, and how circumstances shape the path too. For ages 8+.">
  <a class="skip-link" href="#narration">Skip to the story text</a>
  <SiteNav current="lesson" mode="drawer" />
  <header class="journey-header">
    <div class="journey-home">
      <button class="journey-menu" type="button" data-nav-open aria-label="Open the site index"><Fragment set:html={UI.menu} /></button>
      <a class="journey-brand" href={url('/')}>{SITE.name} <span>{SITE.tagline}</span></a>
    </div>
    <nav class="chapter-trail" aria-label="Chapters">
      <svg class="trail-line" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
        <path id="trail-base"/>
        <path id="trail-done"/>
      </svg>
      <ol id="chapter-list"></ol>
    </nav>
    <button class="quiet-link" id="open-reading" type="button">Read as text</button>
  </header>

  <main class="journey" id="journey">
    <section class="stage" id="stage" aria-label="Illustration">
      <div class="scene scene-paths" id="scene-paths" data-scene="paths">
        <div class="map-stack">
          <canvas id="map-base" aria-hidden="true"></canvas>
          <canvas id="map-today" aria-hidden="true"></canvas>
          <canvas id="map-fx" aria-hidden="true"></canvas>
          <div class="map-callouts" id="map-callouts" aria-hidden="true"></div>
        </div>
        <div class="map-key" id="map-key" hidden aria-hidden="true"><span><i class="k-taken"></i>Path so far</span><span><i class="k-untaken"></i>Not taken</span><span><i class="k-possible"></i>Still possible</span></div>
      </div>
      <div class="scene scene-hike" id="scene-hike" data-scene="hike" hidden></div>
      <div class="scene scene-skills" id="scene-skills" data-scene="skills" hidden></div>
      <div class="scene scene-play" id="scene-play" data-scene="play" hidden></div>
      <div class="scene scene-explore" id="scene-explore" data-scene="explore" hidden></div>
      <p class="sr-only" id="stage-description" aria-live="polite"></p>
    </section>

    <aside class="narration" id="narration" aria-labelledby="beat-heading" tabindex="-1">
      <div class="narration-body" id="narration-body">
        <p class="beat-kicker" id="beat-kicker"></p>
        <h1 id="beat-heading" tabindex="-1"></h1>
        <div class="beat-text" id="beat-text"></div>
        <div class="beat-extra" id="beat-extra"></div>
      </div>
      <footer class="narration-controls">
        <ol class="beat-dots" id="beat-dots" aria-label="Steps in this chapter"></ol>
        <div class="nav-buttons">
          <button class="back-button" id="back" type="button">Back</button>
          <button class="next-button" id="next" type="button">Next</button>
        </div>
        <p class="key-hint">Use ← and → keys to move through the story.</p>
      </footer>
    </aside>
  </main>

  <p class="sr-only" id="announcer" role="status" aria-live="polite"></p>

  <dialog id="reading-dialog" aria-labelledby="journey-reading-title">
    <button class="quiet-link dialog-close" type="button" data-close>Back to the journey</button>
    <div class="nojs-note">JavaScript is off, so the whole lesson is shown as text.</div>
    <Fragment set:html={reading} />
  </dialog>
  <noscript>
    <style>
      .journey-header, .journey, .skip-link, .site-nav { display: none !important; }
      body { overflow: auto !important; }
      #reading-dialog { display: block !important; position: static !important; margin: 0 auto !important; border: 0 !important; max-height: none !important; }
      #reading-dialog .dialog-close { display: none !important; }
      #reading-dialog .nojs-note { display: block !important; }
    </style>
  </noscript>

  <script>
    import '../../../lessons/choices/journey.js';
    import { initSiteNav } from '../../../components/site-nav.js';
    initSiteNav();
  </script>
</BaseLayout>
