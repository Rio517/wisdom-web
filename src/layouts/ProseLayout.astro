---
// A quiet reading column for a Markdown page from the `pages` collection,
// in the page's language when a translation exists, otherwise English.
import { getEntry, render } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import { DEFAULT_LOCALE } from '../i18n/config.js';

interface Props { locale: string; slug: string; current?: string }
const { locale, slug, current = '' } = Astro.props;
const entry = (await getEntry('pages', `${locale}/${slug}`)) ?? (await getEntry('pages', `${DEFAULT_LOCALE}/${slug}`));
if (!entry) throw new Error(`Missing Markdown page "${slug}"`);
const { Content } = await render(entry);
const { title, description, kicker } = entry.data;
// A page still waiting for its translation is marked as English for screen readers and search.
const lang = entry.id.startsWith(`${locale}/`) ? undefined : DEFAULT_LOCALE;
---
<SiteLayout title={title} description={description} current={current} locale={locale}>
  <article class="page page-narrow" lang={lang}>
    <header class="page-header">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</SiteLayout>
