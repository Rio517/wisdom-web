---
import { url } from '../data/site.js';
import { getTranslator, getMessages, pickMessages } from '../i18n/index.js';
import { LOCALES, DEFAULT_LOCALE, LOCALE_TAGS, localizePath, stripLocale, isPublished } from '../i18n/config.js';

// clientMessages: true embeds the whole catalog for browser scripts; an array of key prefixes embeds only those.
interface Props { title?: string; description?: string; bodyClass?: string; locale?: string; clientMessages?: boolean | string[]; noindex?: boolean }
const { title, description, bodyClass, locale = DEFAULT_LOCALE, clientMessages = false } = Astro.props;
// Draft translations stay out of search results and out of other pages' alternates.
const noindex = Astro.props.noindex || !isPublished(locale);
const t = getTranslator(locale);
const name = t('site.name');
const fullTitle = title ? `${title} · ${name}` : `${name} · ${t('site.tagline')}`;
const summary = description ?? t('site.description');
const site = Astro.site ?? new URL('https://wisdom.knyflores.com');
const canonical = new URL(Astro.url.pathname, site);
const basePath = stripLocale(Astro.url.pathname);
const alternates = LOCALES.filter(isPublished).map(code => ({ code, href: new URL(localizePath(basePath, code), site) }));
// Only this page's language ships to the browser; < is escaped so the JSON can't close the tag.
const catalog = Array.isArray(clientMessages) ? pickMessages(locale, clientMessages) : clientMessages ? getMessages(locale) : null;
const messages = catalog ? JSON.stringify(catalog).replaceAll('<', '\\u003c') : null;
---
<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    {noindex ? <meta name="robots" content="noindex" /> : <>
      <link rel="canonical" href={canonical} />
      {alternates.length > 1 && <>
        {alternates.map(alternate => <link rel="alternate" hreflang={LOCALE_TAGS[alternate.code]} href={alternate.href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(localizePath(basePath, DEFAULT_LOCALE), site)} />
      </>}
    </>}
    <meta name="theme-color" content="#fbfbf8" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={title ?? `${name} — ${t('site.tagline')}`} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE_TAGS[locale]} />
    <meta name="twitter:card" content="summary" />
    {messages && <script type="application/json" id="i18n-messages" set:html={messages} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
